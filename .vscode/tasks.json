{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lint site",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/lint.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Build generated site",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/build-site.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Preview on localhost",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test site",
      "type": "shell",
      "command": "node --test --test-concurrency=2 --test-timeout=60000 tests/*.mjs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Check diff whitespace",
      "type": "process",
      "command": "git",
      "args": [
        "diff",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
