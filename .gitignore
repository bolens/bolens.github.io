# OS metadata and editor scratch files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Local credentials; committed examples remain visible.
.env
.env.*
!.env.example
!.env.*.example

# Shared VS Code configuration; keep personal editor state ignored.
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/*.code-snippets
!/.vscode/README.md
